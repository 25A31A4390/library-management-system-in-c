#include <stdio.h>

struct Book {
    int id;
    char name[50];
};

struct Book books[100];
int count = 0;

void addBook() {
    printf("Enter Book ID: ");
    scanf("%d", &books[count].id);

    printf("Enter Book Name: ");
    scanf("%s", books[count].name);

    count++;
}

void displayBooks() {
    for(int i = 0; i < count; i++) {
        printf("\nBook ID: %d", books[i].id);
        printf("\nBook Name: %s\n", books[i].name);
    }
}

int main() {
    int choice;

    while(1) {
        printf("\n1.Add Book");
        printf("\n2.Display Books");
        printf("\n3.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                addBook();
                break;

            case 2:
                displayBooks();
                break;

            case 3:
                return 0;

            default:
                printf("Invalid Choice");
        }
    }
}
